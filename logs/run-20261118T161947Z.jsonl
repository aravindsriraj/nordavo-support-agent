{"ts": "2026-11-18T16:21:10+00:00", "id": "T004", "language": "nl", "category": "feature_request", "priority": "P4", "action": "reply", "confidence": 0.95, "faq_ids": ["F10"], "back_translation": "Thank you for your suggestion! We gladly read every idea. You can view and submit feature requests on our public roadmap via roadmap.roosterly.nl, where you can also vote on ideas. Unfortunately, we cannot promise a fixed delivery date for individual requests.", "refusals": null, "outcome": "posted", "error": null, "tokens": {"input": 6249, "output": 820}}
{"ts": "2026-11-18T16:21:23+00:00", "id": "T005", "language": "nl", "category": "question", "priority": "P4", "action": "reply", "confidence": 1, "faq_ids": ["F02"], "back_translation": "Good morning Anouk,\n\nAs a manager you can add a new employee via Team → Add employee. Fill in the name, email address, and contract hours there and click 'Invite'. The employee will then receive an email to install the app.\n\nKind regards,\nRoosterly", "refusals": null, "outcome": "posted", "error": null, "tokens": {"input": 6150, "output": 676}}
