{"ts": "2026-11-18T16:20:30+00:00", "id": "T001", "language": "nl", "category": "question", "priority": "P4", "action": "reply", "confidence": 0.95, "faq_ids": ["F01"], "back_translation": "Hi Marloes,\n\nYou can log in again by going to app.roosterly.nl/login and clicking on \"Wachtwoord vergeten\" (Forgot password). Enter your email address there.\n\nThe reset link is valid for 60 minutes. Haven't received an email within 10 minutes? Then check your spam folder.\n\nKind regards,\nRoosterly", "refusals": null, "outcome": "posted", "error": null, "tokens": {"input": 9299, "output": 3846}}
{"ts": "2026-11-18T16:20:45+00:00", "id": "T002", "language": "nl", "category": "bug", "priority": "P2", "action": "handoff", "confidence": 0.95, "faq_ids": null, "back_translation": null, "refusals": null, "outcome": "posted", "error": null, "tokens": {"input": 6279, "output": 1031}}
