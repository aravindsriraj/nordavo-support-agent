{"ts": "2026-11-18T15:41:44+00:00", "id": "T026", "language": "nl", "category": "question", "priority": "P4", "action": "reply", "confidence": 0.95, "faq_ids": ["F09"], "back_translation": "All data is stored in the EU (Frankfurt, Germany). It is processed under a data processing agreement, which you can download via Settings → Legal.", "outcome": "posted", "error": null, "tokens": {"input": 6417, "output": 1563}}
