{"ts": "2026-11-18T15:38:50+00:00", "id": "T022", "language": "de", "category": "question", "priority": "P4", "action": "reply", "confidence": 1, "faq_ids": ["F08"], "back_translation": "Yes, both the web app and the mobile app are available in German, Dutch and English. Each user can set the desired language themselves under Profiel → Taal.", "outcome": "posted", "error": null, "tokens": {"input": 5571, "output": 818}}
{"ts": "2026-11-18T15:41:06+00:00", "id": "T023", "language": "nl", "category": "question", "priority": "P4", "action": "reply", "confidence": 0.95, "faq_ids": ["F05"], "back_translation": "You can upgrade at any time under Settings → Subscription. The new price applies from the next invoice.", "outcome": "posted", "error": null, "tokens": {"input": 21102, "output": 16250}}
